# Database
DATABASE_URL="postgresql://alfahd:alfahd_dev_password@localhost:5432/alfahd_ems"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379  # Alternative for production

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App
PORT=3000
NODE_ENV=development

# Email (Nodemailer via SMTP)
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@alfahd.local
# SMTP (required when EMAIL_PROVIDER=smtp)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASS=test
# SMTP_FROM=noreply@alfahd.local  # Optional override, defaults to EMAIL_FROM

# Web / mobile client base URL used in password-reset links
FRONTEND_URL=http://localhost:3001

# CORS allowlist for credentialed requests (comma-separated).
# The web dashboard (Vercel) and this API (Railway) are different origins, and the
# refresh token travels as a cookie — so credentialed CORS is required.
# NEVER use "*": browsers reject a wildcard origin on credentialed requests, which
# silently blocks the cookie and makes every refresh return 401.
# Local:  CORS_ORIGINS=http://localhost:3001
# Prod:   CORS_ORIGINS=https://your-dashboard.vercel.app
# Defaults to FRONTEND_URL when unset.
# CORS_ORIGINS=http://localhost:3001

# Refresh-token cookie attributes. Both default from NODE_ENV, so most setups need
# no override: SameSite=Lax everywhere, plus Secure in production.
#
# Do not hard-code SameSite=None for local dev: browsers reject SameSite=None
# without Secure, and Secure cookies are dropped over plain HTTP. The result looks
# like a frontend bug (refresh always 401s) rather than a config error.
# A native/mobile client on a different origin may opt in with:
#   REFRESH_COOKIE_SAME_SITE=none
#   REFRESH_COOKIE_SECURE=true
# Setting SAME_SITE=none with SECURE=false is rejected at startup by design.
# REFRESH_COOKIE_SAME_SITE=none
# REFRESH_COOKIE_SECURE=true
