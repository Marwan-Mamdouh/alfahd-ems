{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-froggy"
  ],
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--headless",
          "--isolated"
        ]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "browser-mcp": {
        "type": "local",
        "command": ["npx", "-y", "@agent360/browser-mcp@latest"]
      }
    }
  }
}