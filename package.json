{
  "name": "alfahd-ems",
  "private": true,
  "packageManager": "pnpm@11.26.0",
  "scripts": {
    "api:dev": "pnpm types:build && pnpm --filter @alfahd/api start:dev",
    "dev": "pnpm types:build && pnpm -r --parallel --if-present dev",
    "dev:web": "pnpm --filter fahd-dashboard dev",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "api:build": "pnpm --filter @alfahd/api build",
    "types:build": "pnpm --filter @alfahd/types build",
    "build": "pnpm -r build",
    "types:dev": "pnpm --filter @alfahd/types dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "test": "pnpm -r test",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
