{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-froggy"
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--headless",
          "--isolated"
        ]
      }
    }
  }
}
