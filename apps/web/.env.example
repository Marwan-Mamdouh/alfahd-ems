# Server-only. Base URL of the NestJS API, used by next.config.ts as the rewrite
# target for /api/*. Do NOT prefix with NEXT_PUBLIC_ — those values are inlined
# into the client bundle and would expose the internal host.
API_URL=http://localhost:3000

# Port the Next.js dev server listens on. Must differ from the API's PORT (3000)
# or both processes collide and neither starts.
PORT=3001

NEXT_PUBLIC_APP_NAME=