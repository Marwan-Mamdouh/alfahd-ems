        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\r\n    ROLE ||--o{ USER : has\r\n    USER ||--o{ ATTENDANCE : logs\r\n    USER ||--o{ TICKET : assigned_to\r\n    USER ||--o{ TICKET : created_by\r\n    USER ||--o{ TECHNICIAN_LOCATION : broadcasts\r\n    USER ||--o{ WAREHOUSE : manages\r\n    WAREHOUSE ||--o{ INVENTORY_STOCK : stores\r\n    PRODUCT ||--o{ INVENTORY_STOCK : tracked_in\r\n    WAREHOUSE ||--o{ INVENTORY_MOVEMENT : logs\r\n    PRODUCT ||--o{ INVENTORY_MOVEMENT : tracks\r\n    USER ||--o{ INVENTORY_MOVEMENT : records\r\n    CUSTOMER ||--o{ TICKET : raises\r\n    CUSTOMER ||--o{ ROUTER : uses\r\n    WAREHOUSE ||--o{ ROUTER : holds\r\n    USER ||--o{ ROUTER : carries\r\n    ROUTER ||--o{ ROUTER_HISTORY : generates\r\n\r\n    ROLE {\r\n        uuid id PK\r\n        string name \&quot;Admin, CS, Warehouse, Tech\&quot;\r\n        json permissions\r\n    }\r\n\r\n    USER {\r\n        uuid id PK\r\n        uuid role_id FK\r\n        string name\r\n        string email\r\n        string phone\r\n        string password_hash\r\n        string department\r\n        string status \&quot;Active/Inactive\&quot;\r\n    }\r\n\r\n    ATTENDANCE {\r\n        uuid id PK\r\n        uuid user_id FK\r\n        datetime check_in\r\n        datetime check_out\r\n        decimal total_hours\r\n        string status \&quot;Present, Late, Absent\&quot;\r\n    }\r\n\r\n    TECHNICIAN_LOCATION {\r\n        uuid id PK\r\n        uuid user_id FK\r\n        decimal lat\r\n        decimal lng\r\n        boolean is_online\r\n        datetime last_updated\r\n    }\r\n\r\n    CUSTOMER {\r\n        uuid id PK\r\n        string name\r\n        string phone\r\n        string address\r\n        string service_type\r\n        string ip_address \&quot;Unique\&quot;\r\n        datetime created_at\r\n    }\r\n\r\n    PRODUCT {\r\n        uuid id PK\r\n        string name\r\n        string sku\r\n        string description\r\n    }\r\n\r\n    WAREHOUSE {\r\n        uuid id PK\r\n        string name\r\n        string location\r\n        uuid manager_id FK\r\n    }\r\n\r\n    INVENTORY_STOCK {\r\n        uuid id PK\r\n        uuid warehouse_id FK\r\n        uuid product_id FK\r\n        int quantity\r\n        int min_alert_level\r\n    }\r\n\r\n    INVENTORY_MOVEMENT {\r\n        uuid id PK\r\n        uuid product_id FK\r\n        uuid warehouse_id FK\r\n        uuid logged_by FK\r\n        string type \&quot;Inbound, Outbound, Return\&quot;\r\n        int quantity\r\n        datetime created_at\r\n    }\r\n\r\n    ROUTER {\r\n        uuid id PK\r\n        string model\r\n        string serial_number \&quot;Unique\&quot;\r\n        string status \&quot;In_Warehouse, With_Tech, Installed, Defective\&quot;\r\n        uuid warehouse_id FK \&quot;Nullable\&quot;\r\n        uuid technician_id FK \&quot;Nullable\&quot;\r\n        uuid customer_id FK \&quot;Nullable\&quot;\r\n    }\r\n\r\n    ROUTER_HISTORY {\r\n        uuid id PK\r\n        uuid router_id FK\r\n        uuid from_entity_id\r\n        uuid to_entity_id\r\n        uuid logged_by FK\r\n        string action \&quot;Assigned_To_Tech, Installed, Returned\&quot;\r\n        datetime created_at\r\n    }\r\n\r\n    TICKET {\r\n        uuid id PK\r\n        uuid customer_id FK\r\n        string type \&quot;Installation, Tech Issue, Complaint, Maintenance\&quot;\r\n        text description\r\n        string priority \&quot;Low, Medium, High\&quot;\r\n        uuid assigned_technician_id FK\r\n        string status \&quot;Pending, Assigned, In_Progress, Completed\&quot;\r\n        uuid created_by_id FK\r\n        datetime created_at\r\n        datetime completed_at\r\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="381">
